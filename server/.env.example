# Keep Sheets active until the database and migration are validated.
DATA_BACKEND=sheets
# Set DATABASE_URL and AUTH_USERS_JSON in the deployment's secret environment.
DATABASE_URL=
AUTH_USERS_JSON=
DB_POOL_SIZE=8
MIGRATION_ACADEMIC_YEAR=2026-2027
# Bảng học sinh chuẩn hóa, chứa HOC_SINH_CAP2 và HOC_SINH_CAP3.
# SPREADSHEET_ID vẫn được dùng làm dự phòng để triển khai không bị gián đoạn.
SPREADSHEET_ID=
SPREADSHEET_ID_STUDENTS=
SPREADSHEET_ID_ATTENDANCE_C2=
SPREADSHEET_ID_ATTENDANCE_C3=
SPREADSHEET_ID_TUITION_C2=
SPREADSHEET_ID_TUITION_C3=
GOOGLE_CREDENTIALS_JSON=

# Required strong per-user credentials in production (including Sheets mode).
# Optional explicit class-to-attendance-sheet mapping; use exact API class IDs.
ATTENDANCE_SHEET_MAP_JSON=
# Chỉ cần khi mã lớp trên web không trùng chính xác tên sheet học phí.
TUITION_SHEET_MAP_JSON=
