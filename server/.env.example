# Keep Sheets active until the database and migration are validated.
DATA_BACKEND=sheets
# Set DATABASE_URL and AUTH_USERS_JSON in the deployment's secret environment.
DATABASE_URL=
AUTH_USERS_JSON=
DB_POOL_SIZE=8
MIGRATION_ACADEMIC_YEAR=2026-2027
# Existing Google Sheets configuration is retained for initial read-only migration.
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# Required strong per-user credentials in production (including Sheets mode).
# Optional explicit class-to-attendance-sheet mapping; use exact API class IDs.
ATTENDANCE_SHEET_MAP_JSON=
